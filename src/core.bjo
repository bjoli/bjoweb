;; bjoweb/src/core.bjo — the module (bjoweb core).
;;
;; Defines the core types `Request` and `Response`, and the `Handler` type
;; (-bjo-> Request Response). This module is independent of ASP.NET and can
;; be used for testing without a web server. A websocket session is too: it is
;; written against `(net websocket protocol)`, which runs as well over two byte
;; pipes.

(export
  ;; Core types. Transparent records for easy testing and manipulation.
  Request Response Body BodyWriter Handler Header Middleware

  ;; Request construction.
  make-request make-request/streamed RequestBody

  ;; Reading one.
  request-method request-path
  request-scheme request-host request-client
  request-query request-header request-param
  request-query-or request-header-or request-param-or
  request-cookie request-cookie-or

  ;; Its body, which is read when it is asked for, and so suspends.
  request-body request-bytes request-body-port request-form request-form-or

  ;; A multipart body, one part at a time; the part functions are
  ;; `(bjoweb multipart)`'s.
  request-parts next-part!
  part-name part-filename part-content-type part-header
  part-read-some part-bytes part-text

  ;; What a query string and an urlencoded form are written in.
  parse-query

  ;; Making an answer.
  respond text html json-text binary file redirect
  not-found method-not-allowed bad-request server-error

  ;; Answers written as they are produced.
  stream stream-text

  ;; Server-sent events.
  EventSink event-stream send-event!

  ;; Reading one, and adding to it.
  response-status response-content-type response-headers response-body response-text
  with-status with-content-type with-header with-body with-cookie

  ;; Websockets: an upgrade is a kind of answer.
  Session Upgrade websocket

  ;; Middleware pipeline
  pipeline)

(import (std prelude))
(import (only (std ports) read-some byte-pipe write-bytes!))
(import (only (std inbox) make-inbox inbox-close! inbox-closed))
(import (net websocket protocol))
(import (bjoweb multipart))

;; A multipart body's parts, passed on so that one import is enough.
(re-export Parts Part)

(import/class
  (Refusal   (: System.ArgumentException (-> string Refusal)))
  (Misuse    (: System.InvalidOperationException (-> string Misuse)))
  (Violation (: System.Net.ProtocolViolationException (-> string Violation)))
  (Collected (: System.IO.MemoryStream (-> Collected))))

(import/extern
  (collect!     (: System.IO.MemoryStream.Write (-> Collected (Array byte) int int void)))
  (collected    (: System.IO.MemoryStream.ToArray (-> Collected (Array byte))))
  (unescape     (: System.Uri.UnescapeDataString (-> string string)))
  (escape       (: System.Uri.EscapeDataString (-> string string))))

;; Text from a client, read as UTF-8 with what is not UTF-8 as U+FFFD: a body
;; that is not well formed is the handler's to judge, not an error here.
(: lenient-text (-> (Array byte) int int string))
(defun (lenient-text bytes start end)
  (bytes->string bytes #:start start #:end end #:replace (Some #\xFFFD)))

;; ---------------------------------------------------------------------------
;; A header, and the two records
;; ---------------------------------------------------------------------------

;; A header name and value pair. Represented as a `Vec` to allow multiple headers
;; with the same name (e.g., `Set-Cookie`).
(type (: Header (Alias (Tuple string string))))

;; Where a body comes from: bytes already in memory, or a function that opens
;; it as a port that fails once more than the limit it is given has been read.
(type (: BodySource (Union (: InMemory (Array byte))
                           (: FromPort (-> int InputPort)))))

;; How far a body has got. It is read once, into memory, or taken once as a
;; port, and not both.
(type (: BodyState (Union Unread (: Buffered (Array byte)) Taken)))

;; A request's body. `limit` is how much of it may be read into memory. The
;; router copies the request to bind its parameters, and the copies share the
;; two boxes, so a body read by a middleware is read for the handler too.
;; Defined before `Request`, which names it.
(type (: RequestBody #:opaque (Record (: source BodySource)
                                      (: limit int)
                                      (: state (Box BodyState))
                                      (: form (Box (Option (Map string string)))))))

;; Represents an HTTP request.
;; Note: `headers` keys are lower-cased. `body` is read when it is first asked
;; for, not before. `scheme`, `host` and `client` are what the client used,
;; which behind a proxy is not what the connection says: see `request-client`.
(type (: Request (Record (: method string)
                         (: path string)
                         (: query (Map string string))
                         (: headers (Map string string))
                         (: params (Map string string))
                         (: body RequestBody)
                         (: scheme string)
                         (: host string)
                         (: client string))))

;; What runs on an accepted websocket. The socket is closed when it returns.
(type (: Session (-bjo-> WebSocket void)))

;; A request to switch to the websocket protocol, made by `websocket`.
;; `protocol` is sent back as `Sec-WebSocket-Protocol`, `""` for none.
(type (: Upgrade (Record (: session Session)
                         (: protocol string)
                         (: max-message int)
                         (: keep-alive int))))

;; What writes a streamed body, on a fiber of its own. The port is the response
;; body: what is written goes out when the writer flushes it or its buffer
;; fills. The server closes it once the writer returns.
(type (: BodyWriter (-bjo-> OutputPort void)))

;; What a response carries after its headers. `Text` goes out as UTF-8. `File`
;; is the file at that path, read as it is sent. The server sets
;; `Content-Length` for `Text`, `Bytes` and `File`, and sends no body with a
;; status that cannot have one (1xx, 204, 304). A `Streamed` body has no length
;; known in advance, so it goes out chunked. `Upgraded` is what `websocket`
;; answers with.
(type (: Body (Union Empty
                     (: Text string)
                     (: Bytes (Array byte))
                     (: File string)
                     (: Streamed BodyWriter)
                     (: Upgraded Upgrade))))

;; Represents an HTTP response. Nothing is written until the handler has
;; returned one.
(type (: Response (Record (: status int)
                          (: content-type string)
                          (: headers (Vec Header))
                          (: body Body))))

;; A bjoroutine that processes a request and returns a response.
(type (: Handler (-bjo-> Request Response)))

;; A function that wraps a Handler to produce a new Handler.
(type (: Middleware (Alias (-> Handler Handler))))

;; ---------------------------------------------------------------------------
;; Making a request
;; ---------------------------------------------------------------------------

;; Creates a new request, with `body` as its body, written as UTF-8. Route
;; `params` are populated later by the router. With no `#:host`, the host is
;; the one in `headers`, as it is for a request that came straight from a
;; client.
;;
;; The body is in memory already, so no limit applies to reading it.
(: make-request (-> string string (Map string string) (Map string string) string
                    (#:scheme string) (#:host string) (#:client string)
                    Request))
(defun (make-request method path query headers body #:scheme "http" #:host "" #:client "")
  (new-request method path query headers (InMemory (string->bytes body)) 0 scheme host client))

;; The same, with a body that is read from a port when it is asked for: the
;; server's kind. `open` is given a limit and answers the body as a port that
;; fails once more than that has been read. `max-body` is the limit on reading
;; it into memory; `request-body-port` may ask for another.
(: make-request/streamed (-> string string (Map string string) (Map string string)
                             (-> int InputPort) int
                             (#:scheme string) (#:host string) (#:client string)
                             Request))
(defun (make-request/streamed method path query headers open max-body
                              #:scheme "http" #:host "" #:client "")
  (new-request method path query headers (FromPort open) max-body scheme host client))

(: new-request (-> string string (Map string string) (Map string string) BodySource int
                   string string string
                   Request))
(defun (new-request method path query headers source limit scheme host client)
  (Request (method method)
           (path path)
           (query query)
           (headers headers)
           (params (map-empty))
           (body (RequestBody (source source)
                              (limit limit)
                              (state (make-box Unread))
                              (form (make-box None))))
           (scheme scheme)
           (host (if (string-empty? host) (map-ref-or headers "host" "") host))
           (client client)))

;; ---------------------------------------------------------------------------
;; Reading one
;; ---------------------------------------------------------------------------

;; The request method, e.g. `"GET"`, `"POST"`.
(: request-method (-> Request string))
(defun (request-method r) (record-ref r method))

;; The request path, excluding the query string. Always starts with `/`.
(: request-path (-> Request string))
(defun (request-path r) (record-ref r path))

;; `"http"` or `"https"`, as the client asked. A websocket handshake is one or
;; the other too.
(: request-scheme (-> Request string))
(defun (request-scheme r) (record-ref r scheme))

;; The host the client asked for, with its port if it gave one:
;; `"example.com"`, `"127.0.0.1:8080"`. `""` when it named none.
(: request-host (-> Request string))
(defun (request-host r) (record-ref r host))

;; The client's address, `"203.0.113.7"` or `"2001:db8::1"`, with no port.
;; `""` when the connection has none.
;;
;; Behind a reverse proxy the connection is the proxy's, and what the client
;; used — its address, `https`, the host it asked for — comes in
;; `X-Forwarded-For`, `-Proto` and `-Host`. Anybody can send those, so the
;; server believes them only from an address it was told is a proxy: see
;; `#:trusted-proxies`. `request-header` still shows them as they came.
(: request-client (-> Request string))
(defun (request-client r) (record-ref r client))

;; Gets a decoded query parameter, or `None` if absent. Keeps the first value
;; if a parameter is provided multiple times.
(: request-query (-> Request string (Option string)))
(defun (request-query r name) (map-try-ref (record-ref r query) name))

;; Gets a header value case-insensitively.
(: request-header (-> Request string (Option string)))
(defun (request-header r name)
  (map-try-ref (record-ref r headers) (string-downcase name)))

;; Gets a route parameter bound by the router, or `None` if absent.
(: request-param (-> Request string (Option string)))
(defun (request-param r name) (map-try-ref (record-ref r params) name))

;; Accessors with fallback values for when the key is not present.
(: request-query-or (-> Request string string string))
(defun (request-query-or r name fallback)
  (map-ref-or (record-ref r query) name fallback))

(: request-header-or (-> Request string string string))
(defun (request-header-or r name fallback)
  (map-ref-or (record-ref r headers) (string-downcase name) fallback))

(: request-param-or (-> Request string string string))
(defun (request-param-or r name fallback)
  (map-ref-or (record-ref r params) name fallback))

;; ---------------------------------------------------------------------------
;; Its cookies
;; ---------------------------------------------------------------------------
;;
;; The browser sends them all in one `Cookie` header, `a=1; b=2`. HTTP/2 lets it
;; split that into several, and the server joins them again with `; `, so it is
;; one header here either way.

;; A cookie's value, percent-decoded, or `None`. A value may come in quotes,
;; which are not part of it. When two cookies have the same name — one set for
;; `/` and one for `/admin`, say — the browser sends the one for the longer
;; path first, and that is the one given.
(: request-cookie (-> Request string (Option string)))
(defun (request-cookie r name)
  (loop (:for pair (string-split (request-header-or r "cookie" "") ";"))
        (:acc found (folding None (match found
                                    ((Some v) found)
                                    (None (cookie-named name pair)))))))

(: request-cookie-or (-> Request string string string))
(defun (request-cookie-or r name fallback)
  (match (request-cookie r name)
    ((Some v) v)
    (None fallback)))

;; The value in `pair`, `name=value`, if the name is `name`.
(: cookie-named (-> string string (Option string)))
(defun (cookie-named name pair)
  (def parts (string-split pair "="))
  (if (and (>= (vec-length parts) 2) (= (string-trim (vec-ref parts 0)) name))
      (Some (unescape (unquoted (string-trim (join-rest parts)))))
      None))

(: unquoted (-> string string))
(defun (unquoted s)
  (if (and (>= (string-length s) 2) (string-starts-with? s "\"") (string-ends-with? s "\""))
      (.Substring s 1 (- (string-length s) 2))
      s))

;; ---------------------------------------------------------------------------
;; Reading its body
;; ---------------------------------------------------------------------------
;;
;; Nothing reads a body until something asks for it, so a request answered 401
;; or 404 is never read at all. What is read into memory is kept, for the
;; next thing that asks.

;; The whole body, as it came. Past the server's `#:max-body` it raises, and
;; the server answers 413.
(: request-bytes (-bjo-> Request (Array byte)))
(defbjo (request-bytes r)
  (def body (record-ref r body))
  (def state (record-ref body state))
  (match (box-ref state)
    ((Buffered bytes) bytes)
    (Taken (raise (cast Exception (Misuse. "the request body was taken as a port"))))
    (Unread
     (def bytes (match (record-ref body source)
                  ((InMemory bytes) bytes)
                  ((FromPort open) (read-to-end (open (record-ref body limit))))))
     (box-set! state (Buffered bytes))
     bytes)))

;; The body as UTF-8 text, `""` when there was none. A byte order mark at the
;; start is left out.
(: request-body (-bjo-> Request string))
(defbjo (request-body r)
  (def bytes (request-bytes r))
  (def n (array-length bytes))
  (if (and (>= n 3)
           (= (array-ref bytes 0) 239uy) (= (array-ref bytes 1) 187uy) (= (array-ref bytes 2) 191uy))
      (lenient-text bytes 3 n)
      (lenient-text bytes 0 n)))

;; The body as a port, for one that should not be held in memory: an upload,
;; read and written somewhere as it arrives. `#:max-body` is how much of it may
;; be read, the server's `#:max-body` when it is 0; a read past it raises, and
;; the server answers 413.
;;
;; It is the one port there is. Once it is taken, `request-body` and the rest
;; raise; a body already read into memory is served from there instead.
(: request-body-port (-> Request (#:max-body int) InputPort))
(defun (request-body-port r #:max-body 0)
  (def body (record-ref r body))
  (def state (record-ref body state))
  (match (box-ref state)
    ((Buffered bytes) (bytes-port bytes))
    (Taken (raise (cast Exception (Misuse. "the request body was taken as a port already"))))
    (Unread
     (box-set! state Taken)
     (match (record-ref body source)
       ((InMemory bytes) (bytes-port bytes))
       ((FromPort open) (open (if (> max-body 0) max-body (record-ref body limit))))))))

;; A form field, or `None`: from an `application/x-www-form-urlencoded` body,
;; or from a `multipart/form-data` one, whose files are left out. The first
;; value, if a field is given more than once. Reads the body into memory, once,
;; so the server's `#:max-body` applies; a form with files in it that are too
;; big for that is read with `request-parts` instead.
(: request-form (-bjo-> Request string (Option string)))
(defbjo (request-form r name) (map-try-ref (form-of r) name))

(: request-form-or (-bjo-> Request string string string))
(defbjo (request-form-or r name fallback) (map-ref-or (form-of r) name fallback))

(: form-of (-bjo-> Request (Map string string)))
(defbjo (form-of r)
  (def kept (record-ref (record-ref r body) form))
  (match (box-ref kept)
    ((Some fields) fields)
    (None
     (def content-type (request-header-or r "content-type" ""))
     (def fields
       (cond
         ((string-starts-with? content-type "application/x-www-form-urlencoded")
          (parse-query (request-body r)))
         (else
          (match (multipart-boundary content-type)
            ((Some boundary) (text-fields (read-parts (bytes-port (request-bytes r)) boundary)))
            (None (map-empty))))))
     (box-set! kept (Some fields))
     fields)))

;; The parts that are not files, as a form.
(: text-fields (-bjo-> Parts (Map string string)))
(defbjo (text-fields parts)
  (let go ((fields (map-empty)))
    (match (next-part! parts)
      (None fields)
      ((Some p)
       (match (part-filename p)
         ((Some file) (go fields))
         (None (go (if (map-contains? fields (part-name p))
                       fields
                       (map-set fields (part-name p) (part-text p))))))))))

;; The parts of a `multipart/form-data` body, one at a time as `next-part!`
;; asks for them, so that a file in it is never held whole. The body is taken
;; as `request-body-port` takes it, with the same `#:max-body`.
;;
;; A body that is not multipart, or is malformed, raises a
;; `ProtocolViolationException`, and the server answers 400.
(: request-parts (-> Request (#:max-body int) Parts))
(defun (request-parts r #:max-body 0)
  (match (multipart-boundary (request-header-or r "content-type" ""))
    ((Some boundary) (read-parts (request-body-port r #:max-body max-body) boundary))
    (None (raise (cast Exception (Violation. "the body is not multipart/form-data"))))))

(: read-to-end (-bjo-> InputPort (Array byte)))
(defbjo (read-to-end p)
  (def all (Collected.))
  (let go ()
    (match (read-some p)
      ((Some chunk) (collect! all chunk 0 (array-length chunk)) (go))
      (None (collected all)))))

;; A pipe is in memory, so writing all of it at once never waits.
(: bytes-port (-> (Array byte) InputPort))
(defun (bytes-port bytes)
  (match (byte-pipe)
    ((Tuple in out)
     (write-bytes! out bytes)
     (close-output-port out)
     in)))

;; ---------------------------------------------------------------------------
;; Query strings and urlencoded forms
;; ---------------------------------------------------------------------------

;; `a=1&b=two+words` as a map, decoded, with `+` read as a space. A leading `?`
;; is skipped, and the first value is kept for a name given more than once.
(: parse-query (-> string (Map string string)))
(defun (parse-query raw)
  (def text (if (string-starts-with? raw "?") (drop-first raw) raw))
  ;; Most requests have no query.
  (if (string-empty? text)
      (map-empty)
      (loop (:for pair (string-split text "&"))
            (:when (not (string-empty? pair)))
            (:acc all (folding (map-empty) (add-parameter all pair))))))

(: add-parameter (-> (Map string string) string (Map string string)))
(defun (add-parameter all pair)
  (def parts (string-split pair "="))
  (def name (url-decode (vec-ref parts 0)))
  ;; Splits on the first '=' to separate key and value.
  (def value (if (< (vec-length parts) 2) "" (url-decode (join-rest parts))))
  (if (map-contains? all name) all (map-set all name value)))

(: join-rest (-> (Vec string) string))
(defun (join-rest parts)
  (string-join (loop (:for i (range 1 (vec-length parts)))
                     (:acc out (vecing (vec-ref parts i))))
               "="))

(: url-decode (-> string string))
(defun (url-decode s) (unescape (string-replace s "+" " ")))

(: drop-first (-> string string))
(defun (drop-first s)
  (substring s
             (string-cursor-next s (string-cursor-start s))
             (string-cursor-end s)))

;; ---------------------------------------------------------------------------
;; Making an answer
;; ---------------------------------------------------------------------------

;; Creates a base response. Other helpers build on this.
(: respond (-> int string (#:content-type string) (#:headers (Vec Header)) Response))
(defun (respond status body #:content-type "text/plain; charset=utf-8" #:headers (vec-empty))
  (Response (status status) (content-type content-type) (headers headers) (body (Text body))))

;; Accepts a websocket and runs `session` on it.
;;
;; A handler that returns this has decided to accept, so the checks a handler
;; makes — authentication, `Origin`, which subprotocol — come first, and a
;; middleware that answers 401 instead works as it does for any other route.
;; A request that is not a websocket handshake is answered 426 or 400 without
;; calling `session`. Headers added with `with-header` go out with the `101`.
;;
;; `#:max-message` bounds one message after reassembly; a bigger one closes the
;; socket with 1009. `#:keep-alive` is how many idle milliseconds pass before a
;; ping, 0 for none.
(: websocket (-> Session (#:protocol string) (#:max-message int) (#:keep-alive int) Response))
(defun (websocket session #:protocol "" #:max-message 1048576 #:keep-alive 30000)
  (Response (status 101) (content-type "") (headers (vec-empty))
            (body (Upgraded (Upgrade (session session)
                                     (protocol protocol)
                                     (max-message max-message)
                                     (keep-alive keep-alive))))))

(: text (-> string (#:status int) Response))
(defun (text body #:status 200) (respond status body))

(: html (-> string (#:status int) Response))
(defun (html body #:status 200)
  (respond status body #:content-type "text/html; charset=utf-8"))

;; Creates a JSON response from an already serialized JSON string.
(: json-text (-> string (#:status int) Response))
(defun (json-text body #:status 200)
  (respond status body #:content-type "application/json; charset=utf-8"))

;; Bytes as they are: an image, a download, anything that is not text.
(: binary (-> (Array byte) (#:status int) (#:content-type string) Response))
(defun (binary data #:status 200 #:content-type "application/octet-stream")
  (Response (status status) (content-type content-type) (headers (vec-empty)) (body (Bytes data))))

;; The file at `path`, sent as it is. It is opened when the answer is written,
;; after the handler has returned, and read a piece at a time, so a big one is
;; never all in memory; `Content-Length` is its size then. A file that is not
;; there by that time is answered 404.
(: file (-> string (#:status int) (#:content-type string) Response))
(defun (file path #:status 200 #:content-type "application/octet-stream")
  (Response (status status) (content-type content-type) (headers (vec-empty)) (body (File path))))

;; A body written as it is produced: a large download, or the output of a long
;; computation. `writer` runs on a fiber of its own once the head has gone out,
;; and gets the response body as an output port, for bytes and text alike.
;; `flush-port` sends what has been written so far.
;;
;; The body ends cleanly when `writer` returns. When it raises, when the client
;; goes away or when the server stops, the connection is aborted instead, so
;; that a client sees an incomplete response rather than a short one that looks
;; whole. A `HEAD` gets the head alone, and `writer` is not called.
(: stream (-> BodyWriter (#:status int) (#:content-type string) Response))
(defun (stream writer #:status 200 #:content-type "application/octet-stream")
  (Response (status status) (content-type content-type) (headers (vec-empty)) (body (Streamed writer))))

;; `stream` for text: the same port, which writes text as UTF-8, under a
;; content type that says so.
(: stream-text (-> BodyWriter (#:status int) (#:content-type string) Response))
(defun (stream-text writer #:status 200 #:content-type "text/plain; charset=utf-8")
  (stream writer #:status status #:content-type content-type))

;; ---------------------------------------------------------------------------
;; Server-sent events
;; ---------------------------------------------------------------------------

;; Where an event stream's writer sends its events. The port belongs to a loop
;; that also writes the keep-alives, and an event reaches it over `texts`
;; whole, so that nothing is ever written into the middle of one. `over` is
;; closed once the stream is.
(type (: EventSink #:opaque (Record (: texts (Chan string))
                                    (: over (Inbox Unit)))))

;; A stream of server-sent events, for a browser's `EventSource`. `writer` runs
;; as a `stream` writer does, and sends with `send-event!`; the stream ends
;; when it returns.
;;
;; A comment goes out at once, so that the stream is seen to be open before
;; there is anything to say, and another after every `#:keep-alive`
;; milliseconds without an event, 0 for none, so that no proxy on the way
;; takes a quiet stream for a dead one. `#:retry`, when it is not 0, tells the
;; browser how many milliseconds to wait before it reconnects.
;;
;; A browser reconnects on its own, with the last `#:id` it saw as the
;; `Last-Event-ID` request header, for the handler to carry on from.
(: event-stream (-> (-bjo-> EventSink void) (#:keep-alive int) (#:retry int) Response))
(defun (event-stream writer #:keep-alive 15000 #:retry 0)
  (with-header (with-header (stream (bjoroutine (out) (run-events writer keep-alive retry out))
                                    #:content-type "text/event-stream")
                            "Cache-Control" "no-cache")
               ;; nginx buffers a response unless it is told not to.
               "X-Accel-Buffering" "no"))

;; Sends one event: `data`, which may have line breaks in it, with an event
;; name when `#:event` is not `""`, and an id when `#:id` is not. `#f` once the
;; stream is over.
;;
;; A line break in the name or the id would begin a field of its own, so it is
;; refused with an `ArgumentException`.
(: send-event! (-bjo-> EventSink string (#:event string) (#:id string) bool))
(defbjo (send-event! sink data #:event "" #:id "")
  (def text (event-text data event id))
  (sync (choose (wrap (chan-send (record-ref sink texts) text) (fun (u) #t))
                (wrap (inbox-closed (record-ref sink over)) (fun (e) #f)))))

(: event-text (-> string string string string))
(defun (event-text data event id)
  (one-line "#:event" event)
  (one-line "#:id" id)
  (str (if (string-empty? event) "" (str "event: " event "\n"))
       (if (string-empty? id) "" (str "id: " id "\n"))
       (string-join (vec-map (fun (l) (str "data: " l "\n"))
                             (string-split (string-replace (string-replace data "\r\n" "\n") "\r" "\n")
                                           "\n"))
                    "")
       "\n"))

;; The message shows the line breaks escaped, since it may well end up in a
;; log, one line per entry.
(: one-line (-> string string void))
(defun (one-line what s)
  (when (or (string-contains? s "\n") (string-contains? s "\r"))
    (raise (cast Exception
                 (Refusal. (str what " has a line break in it: "
                                (string-replace (string-replace s "\r" "\\r") "\n" "\\n")))))))

;; What woke the loop that owns an event stream's port.
(type (: Relayed (Union (: Finished (Result Exception Unit))
                        (: Said string)
                        Quiet)))

;; Once the writer has returned, anything it started is stopped, and a sink
;; that has outlived the stream answers `#f`.
(: run-events (-bjo-> (-bjo-> EventSink void) int int OutputPort void))
(defbjo (run-events writer keep-alive retry port)
  (def texts (make-chan))
  (def over (make-inbox 1 DropNewest))
  (say! port (str ":\n" (if (> retry 0) (str "retry: " (int->string retry) "\n\n") "")))
  (def ending
    (try
        (with-cancel (stop)
          (def running (bjo (writer (EventSink (texts texts) (over over)))))
          (def finished (relay port texts running keep-alive))
          (stop (Requested "the event stream is over"))
          finished)
      #:finally (inbox-close! over)))
  (match ending
    ((Ok u) unit)
    ((Err e) (raise e))))

;; Writes what the writer sends, and a comment whenever it has been quiet for
;; `keep-alive` milliseconds, until it returns.
(: relay (-bjo-> OutputPort (Chan string) (Promise Unit) int (Result Exception Unit)))
(defbjo (relay port texts running keep-alive)
  (let go ()
    (match (sync (choose (wrap (chan-recv texts) (fun (t) (Said t)))
                         (wrap (promise-join running) (fun (r) (Finished r)))
                         (wrap (quiet-for keep-alive) (fun (u) Quiet))))
      ((Said t) (say! port t) (go))
      (Quiet (say! port ":\n") (go))
      ((Finished r) r))))

(: quiet-for (-> int (Event Unit)))
(defun (quiet-for ms) (if (> ms 0) (timeout ms) (never)))

(: say! (-bjo-> OutputPort string void))
(defbjo (say! port text)
  (write-string port text)
  (flush-port port))

;; Creates a redirect response. Defaults to 302 (Found) unless `#:permanent #t` is specified.
(: redirect (-> string (#:permanent bool) Response))
(defun (redirect location #:permanent #f)
  (respond (if permanent 301 302) ""
           #:headers [(Tuple "Location" location)]))

(: not-found (-> (#:body string) Response))
(defun (not-found #:body "404 Not Found\n") (respond 404 body))

;; Creates a 405 Method Not Allowed response with the given `Allow` header.
(: method-not-allowed (-> string Response))
(defun (method-not-allowed allow)
  (respond 405 "405 Method Not Allowed\n" #:headers [(Tuple "Allow" allow)]))

(: bad-request (-> string Response))
(defun (bad-request why) (respond 400 (str "400 Bad Request: " why "\n")))

;; Creates a 500 Internal Server Error response. Exception details are not included.
(: server-error (-> Response))
(defun (server-error) (respond 500 "500 Internal Server Error\n"))

;; ---------------------------------------------------------------------------
;; Reading an answer, and adding to it
;; ---------------------------------------------------------------------------

(: response-status (-> Response int))
(defun (response-status r) (record-ref r status))

(: response-content-type (-> Response string))
(defun (response-content-type r) (record-ref r content-type))

(: response-headers (-> Response (Vec Header)))
(defun (response-headers r) (record-ref r headers))

(: response-body (-> Response Body))
(defun (response-body r) (record-ref r body))

;; The body when it is `Text`, for a test or a middleware that looks at it.
(: response-text (-> Response (Option string)))
(defun (response-text r)
  (match (record-ref r body)
    ((Text s) (Some s))
    (_ None)))

;; Helpers for modifying a response in a pipeline style.
(: with-status (-> Response int Response))
(defun (with-status r code) (record-set r (status code)))

(: with-content-type (-> Response string Response))
(defun (with-content-type r ct) (record-set r (content-type ct)))

(: with-body (-> Response Body Response))
(defun (with-body r b) (record-set r (body b)))

;; Appends a header to the response, allowing multiple headers with the same name.
(: with-header (-> Response string string Response))
(defun (with-header r name value)
  (record-set r (headers (vec-add (record-ref r headers) (Tuple name value)))))

;; Sets a cookie: adds a `Set-Cookie` header, one for each cookie. What the
;; browser is told to do with it starts at the careful choice, since a cookie
;; that is too open still works and nothing tells anyone:
;;
;; - `#:http-only #t`: scripts on the page cannot read it, so one that was
;;   slipped into a page cannot carry a session away.
;; - `#:secure #t`: it goes over https only. Browsers count `http://localhost`
;;   as secure, so it works while an application is being written; on any
;;   other plain http address the browser drops it.
;; - `#:same-site "Lax"`: it is sent when the user follows a link here, and not
;;   with another site's form posts or fetches. `"Strict"` not even with the
;;   link, `"None"` with everything (browsers take that only with `#:secure`),
;;   `""` leaves it to the browser.
;; - `#:path "/"`: it is sent for every path on the site.
;; - `#:domain ""`: to this host alone. A domain sends it to the subdomains too.
;; - `#:max-age -1`: it is kept until the browser closes. Otherwise it is kept
;;   so many seconds, and `0` deletes it: set it again with the path and domain
;;   it was set with, and any value.
;;
;; The value is percent-encoded, so it may be any text, and `request-cookie`
;; decodes it. A name that is not an HTTP token, a path or domain with a `;` or
;; a control character in it, or another `#:same-site`, raises
;; `ArgumentException`.
(: with-cookie (-> Response string string
                   (#:path string) (#:domain string) (#:max-age int)
                   (#:http-only bool) (#:secure bool) (#:same-site string)
                   Response))
(defun (with-cookie r name value #:path "/" #:domain "" #:max-age -1
                    #:http-only #t #:secure #t #:same-site "Lax")
  (when (or (string-empty? name) (any-char? (fun (c) (not (token-char? c))) name))
    (refuse (str "a cookie name must be a token: \"" name "\"")))
  (when (any-char? (fun (c) (not (attribute-char? c))) path)
    (refuse (str "a cookie path cannot hold a ';' or a control character: \"" path "\"")))
  (when (any-char? (fun (c) (not (attribute-char? c))) domain)
    (refuse (str "a cookie domain cannot hold a ';' or a control character: \"" domain "\"")))
  (unless (or (= same-site "Lax") (= same-site "Strict") (= same-site "None") (= same-site ""))
    (refuse (str "#:same-site is \"Lax\", \"Strict\", \"None\" or \"\", not \"" same-site "\"")))
  (when (and (= same-site "None") (not secure))
    (refuse "#:same-site \"None\" needs #:secure #t; browsers drop the cookie otherwise"))
  (with-header r "Set-Cookie"
               (str name "=" (escape value)
                    (if (string-empty? path) "" (str "; Path=" path))
                    (if (string-empty? domain) "" (str "; Domain=" domain))
                    (if (< max-age 0) "" (str "; Max-Age=" (int->string max-age)))
                    (if secure "; Secure" "")
                    (if http-only "; HttpOnly" "")
                    (if (string-empty? same-site) "" (str "; SameSite=" same-site)))))

;; A letter, a digit, or one of the marks an HTTP token may hold.
(: token-char? (-> char bool))
(defun (token-char? c)
  (def n (char->integer c))
  (or (and (>= n 48) (<= n 57))
      (and (>= n 65) (<= n 90))
      (and (>= n 97) (<= n 122))
      (any-char? (fun (d) (= d c)) "!#$%&'*+-.^_`|~")))

;; Printable ASCII, and not the `;` that would start another attribute.
(: attribute-char? (-> char bool))
(defun (attribute-char? c)
  (def n (char->integer c))
  (and (>= n 32) (<= n 126) (not (= c #\;))))

(: any-char? (-> (-> char bool) string bool))
(defun (any-char? pred s)
  (match (string-index pred s)
    ((Some at) #t)
    (None #f)))

(: refuse (-> string %a))
(defun (refuse why) (raise (cast Exception (Refusal. why))))

;; ---------------------------------------------------------------------------
;; Middleware Pipeline
;; ---------------------------------------------------------------------------

;; Composes middlewares to wrap a target handler.
;; `(pipeline h m1 m2)` results in `(m1 (m2 h))`.
(: pipeline (-> Handler #:rest Middleware Handler))
(defun (pipeline h #:rest middlewares)
  (def ms (loop (:for m (in-array middlewares)) (:acc out (vecing m))))
  (let go ((i (- (vec-length ms) 1)) (curr h))
    (if (< i 0)
        curr
        (go (- i 1) ((vec-ref ms i) curr)))))
