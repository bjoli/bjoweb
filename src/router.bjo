;; bjoweb/src/router.bjo — the module (bjoweb router).
;;
;; Defines the router for matching requests to handlers.
;; Routes are evaluated in the order they are defined. First match wins.
;; Supported pattern segments:
;; - Literal: exact match (e.g., "users")
;; - Param: matches one segment and binds it (e.g., ":id")
;; - Rest: matches remaining segments and binds them (e.g., "*path")

(export
  ;; Routing types.
  Segment Route Router Match

  ;; Building a table.
  router route with-fallback with-middleware
  route-get route-post route-put route-patch route-delete route-head

  ;; Using one.
  router-match handle

  ;; Reading one, and the path splitter the two of them share.
  router-routes router-fallback route-method route-pattern route-handler
  path-segments)

(import (std prelude))
(import (bjoweb core))

;; ---------------------------------------------------------------------------
;; The types
;; ---------------------------------------------------------------------------

;; One segment of a route pattern.
;; `Rest` binds the remaining path. A bare `*` binds to `"rest"`.
(type (: Segment (Union (: Literal string) (: Param string) (: Rest string))))

;; A single route definition, including its parsed segments.
(type (: Route (Record (: method string)
                       (: pattern string)
                       (: segments (Vec Segment))
                       (: handler Handler))))

(type (: Router (Record (: routes (Vec Route))
                        (: fallback Handler))))

;; The result of matching a request against the router.
;; Can be matched, unmatched (404), or wrong method (405).
(type (: Match (Union (: Matched Request Handler)
                      (: WrongMethod string)
                      Unmatched)))

;; ---------------------------------------------------------------------------
;; Building a table
;; ---------------------------------------------------------------------------

;; Splits a path into segments, ignoring empty segments (e.g., trailing slashes).
(: path-segments (-> string (Vec string)))
(defun (path-segments path)
  (loop (:for piece (string-split path "/"))
        (:when (not (string-empty? piece)))
        (:acc out (vecing piece))))

;; Returns the string without its first character.
(: drop-first (-> string string))
(defun (drop-first s)
  (substring s
             (string-cursor-next s (string-cursor-start s))
             (string-cursor-end s)))

(: parse-segment (-> string Segment))
(defun (parse-segment piece)
  (cond
    ((string-starts-with? piece ":") (Param (drop-first piece)))
    ((string-starts-with? piece "*")
     (Rest (if (= (string-count piece) 1) "rest" (drop-first piece))))
    (else (Literal piece))))

;; Creates a route for a specific HTTP method.
(: route (-> string string Handler Route))
(defun (route method pattern handler)
  (Route (method (string-upcase method))
         (pattern pattern)
         (segments (loop (:for piece (path-segments pattern))
                         (:acc out (vecing (parse-segment piece)))))
         (handler handler)))

(: route-get (-> string Handler Route))
(defun (route-get pattern handler) (route "GET" pattern handler))

(: route-post (-> string Handler Route))
(defun (route-post pattern handler) (route "POST" pattern handler))

(: route-put (-> string Handler Route))
(defun (route-put pattern handler) (route "PUT" pattern handler))

(: route-patch (-> string Handler Route))
(defun (route-patch pattern handler) (route "PATCH" pattern handler))

(: route-delete (-> string Handler Route))
(defun (route-delete pattern handler) (route "DELETE" pattern handler))

;; Creates a HEAD route. (Note: GET routes automatically handle HEAD requests).
(: route-head (-> string Handler Route))
(defun (route-head pattern handler) (route "HEAD" pattern handler))

;; The default fallback handler (returns 404).
(: default-fallback (-bjo-> Request Response))
(defbjo (default-fallback req) (not-found))

;; Constructs a Router from a list of routes.
(: router (-> #:rest Route Router))
(defun (router #:rest rs)
  (Router (routes (loop (:for r (in-array rs)) (:acc out (vecing r))))
          (fallback default-fallback)))

;; Sets a custom fallback handler for unmatched requests.
(: with-fallback (-> Router Handler Router))
(defun (with-fallback rt handler) (record-set rt (fallback handler)))

;; Wraps each route's handler and the fallback, as `pipeline` wraps one
;; handler: `(with-middleware rt m1 m2)` gives each handler `(m1 (m2 h))`. A
;; middleware runs after the route matched, so it sees the bound parameters.
;; A 405 is answered by the router, and goes through none of them.
(: with-middleware (-> Router #:rest Middleware Router))
(defun (with-middleware rt #:rest middlewares)
  (def ms (loop (:for m (in-array middlewares)) (:acc out (vecing m))))
  (def wrap (fun (h)
              (let go ((i (- (vec-length ms) 1)) (curr h))
                (if (< i 0)
                    curr
                    (go (- i 1) ((vec-ref ms i) curr))))))
  (Router (routes (vec-map (fun (r) (record-set r (handler (wrap (record-ref r handler)))))
                           (record-ref rt routes)))
          (fallback (wrap (record-ref rt fallback)))))

(: router-routes (-> Router (Vec Route)))
(defun (router-routes rt) (record-ref rt routes))

(: router-fallback (-> Router Handler))
(defun (router-fallback rt) (record-ref rt fallback))

(: route-method (-> Route string))
(defun (route-method r) (record-ref r method))

(: route-pattern (-> Route string))
(defun (route-pattern r) (record-ref r pattern))

(: route-handler (-> Route Handler))
(defun (route-handler r) (record-ref r handler))

;; ---------------------------------------------------------------------------
;; Matching
;; ---------------------------------------------------------------------------

;; Matching runs for every request, so it allocates little: the path's pieces
;; are slices of it in an array of the exact size, not a `Vec` of copies, a
;; route is first tested without binding anything, and only the route that
;; matched binds its parameters. Splitting the path into a `Vec` and binding
;; as it went cost about 900 bytes a request.

;; The cursor at or after `c` that is not on a `/`, or the end.
(: past-slashes (-> string StringCursor StringCursor))
(defun (past-slashes path c)
  (if (and (not (string-cursor-end? path c)) (char=? (string-cursor-ref path c) #\/))
      (past-slashes path (string-cursor-next path c))
      c))

;; The cursor at or after `c` that is on a `/`, or the end.
(: to-slash (-> string StringCursor StringCursor))
(defun (to-slash path c)
  (if (or (string-cursor-end? path c) (char=? (string-cursor-ref path c) #\/))
      c
      (to-slash path (string-cursor-next path c))))

;; How many pieces `path-segments` would answer.
(: piece-count (-> string int))
(defun (piece-count path)
  (let go ((c (past-slashes path (string-cursor-start path))) (n 0))
    (if (string-cursor-end? path c)
        n
        (go (past-slashes path (to-slash path c)) (+ n 1)))))

;; The pieces of `path-segments`, as slices of `path`.
(: path-pieces (-> string (Array string)))
(defun (path-pieces path)
  (def out (make-array (piece-count path)))
  (let go ((c (past-slashes path (string-cursor-start path))) (i 0))
    (unless (string-cursor-end? path c)
      (def end (to-slash path c))
      (array-set! out i (substring/slice path c end))
      (go (past-slashes path end) (+ i 1))))
  out)

;; Whether the segments match the pieces. Binds nothing.
(: segments-match? (-> (Vec Segment) (Array string) bool))
(defun (segments-match? segs pieces)
  (def n (vec-length segs))
  (def m (array-length pieces))
  (let go ((i 0))
    (if (>= i n)
        ;; Match succeeds only if all path pieces are consumed.
        (= m i)
        (match (vec-ref segs i)
          ;; `Rest` consumes all remaining pieces.
          ((Rest name) #t)
          ((Param name) (and (< i m) (go (+ i 1))))
          ((Literal want) (and (< i m) (= want (array-ref pieces i)) (go (+ i 1))))))))

;; The parameters that segments which match bind.
(: bind-params (-> (Vec Segment) (Array string) (Map string string)))
(defun (bind-params segs pieces)
  (let go ((i 0) (params (map-empty)))
    (if (>= i (vec-length segs))
        params
        (match (vec-ref segs i)
          ((Rest name) (map-set params name (join-from pieces i)))
          ((Param name) (go (+ i 1) (map-set params name (array-ref pieces i))))
          ((Literal want) (go (+ i 1) params))))))

;; Joins elements of `pieces` from index `from` using slashes.
(: join-from (-> (Array string) int string))
(defun (join-from pieces from)
  (string-join (loop (:for j (range from (array-length pieces)))
                     (:acc out (vecing (array-ref pieces j))))
               "/"))

;; The index of the first route for the method whose segments match, or -1.
(: find-route (-> Router (Array string) string int))
(defun (find-route rt pieces method)
  (def rs (record-ref rt routes))
  (let go ((i 0))
    (cond
      ((>= i (vec-length rs)) -1)
      ((let ((r (vec-ref rs i)))
         (and (= (record-ref r method) method)
              (segments-match? (record-ref r segments) pieces)))
       i)
      (else (go (+ i 1))))))

;; The methods the path is served for, each once: the ones its routes name, in
;; route order, then `HEAD` if one of them is `GET`, then `OPTIONS`, which
;; `handle` answers for every path that has a route. Empty when no route has
;; the path.
(: allowed-methods (-> Router (Array string) (Vec string)))
(defun (allowed-methods rt pieces)
  (def written
    (loop (:for r (record-ref rt routes))
          (:when (segments-match? (record-ref r segments) pieces))
          (:acc out (folding (vec-empty) (add-missing out (record-ref r method))))))
  (if (vec-empty? written)
      written
      (add-missing (if (vec-contains written "GET") (add-missing written "HEAD") written)
                   "OPTIONS")))

(: add-missing (-> (Vec string) string (Vec string)))
(defun (add-missing methods m)
  (if (vec-contains methods m) methods (vec-add methods m)))

;; Matches a request against the router's routes.
;; Falls back to matching GET routes for HEAD requests.
(: router-match (-> Router Request Match))
(defun (router-match rt req)
  (def pieces (path-pieces (request-path req)))
  (def wanted (request-method req))
  (def found (find-route rt pieces wanted))
  (def found (if (and (< found 0) (= wanted "HEAD")) (find-route rt pieces "GET") found))
  (if (>= found 0)
      (bind-match req (vec-ref (record-ref rt routes) found) pieces)
      (let ((allow (allowed-methods rt pieces)))
        (if (vec-empty? allow)
            Unmatched
            (WrongMethod (string-join allow ", "))))))

;; The parameters are slices of the path, which the request holds anyway. A
;; parameter kept after the request keeps the path alive with it, a few dozen
;; bytes; copying each would cost an allocation for every request.
(: bind-match (-> Request Route (Array string) Match))
(defun (bind-match req r pieces)
  (def segs (record-ref r segments))
  (def params (if (has-params? segs) (bind-params segs pieces) (map-empty)))
  (Matched (record-set req (params params)) (record-ref r handler)))

(: has-params? (-> (Vec Segment) bool))
(defun (has-params? segs)
  (let go ((i 0))
    (cond ((>= i (vec-length segs)) #f)
          ((match (vec-ref segs i) ((Literal w) #f) (_ #t)) #t)
          (else (go (+ i 1))))))

;; Dispatches a request to the appropriate handler based on the router.
;;
;; An `OPTIONS` that no route of its own takes is answered 204 with `Allow`,
;; as RFC 9110 asks. A CORS preflight needs more headers than that, so a
;; program that takes cross-origin requests gives `OPTIONS` a route.
(: handle (-bjo-> Router Request Response))
(defbjo (handle rt req)
  (match (router-match rt req)
    ((Matched bound handler) (handler bound))
    ((WrongMethod allow)
     (if (= (request-method req) "OPTIONS")
         (respond 204 "" #:headers [(Tuple "Allow" allow)])
         (method-not-allowed allow)))
    (Unmatched ((record-ref rt fallback) req))))
