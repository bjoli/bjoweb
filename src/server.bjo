;; bjoweb/src/server.bjo — the module (bjoweb server).
;;
;; Provides a web server integrating ASP.NET Kestrel with Bjolang fibers.
;; Requests are bridged from Kestrel threads into an inbox, where worker
;; fibers process them using the provided `Router`.
;;
;; A websocket is Kestrel's raw upgraded stream with `(net websocket protocol)`
;; over it.
;; Its call is handed from the worker to a session fiber of its own, because
;; answering the call is what gives the connection back to Kestrel, and a
;; socket may stay open for hours.

(export
  ;; Server lifecycle and info.
  Server serve start-server stop-server!
  server-url server-port server-dropped-count

  ;; The raw `HttpContext` type, for a program that needs what bjoweb does not
  ;; expose.
  Ctx)

(import (std inbox))
(import (only (std net) stream->ports))
(import (only (std ports) close-byte-output-port!))
(import (only (net websocket protocol)
              ports->websocket websocket-accept-key websocket-close! websocket-closed))
(import (bjoweb core))
(import (bjoweb router))

;; ===========================================================================
;; Interop
;; ===========================================================================
;;
;; .NET interoperability definitions.

(import/class
  (App         (: Microsoft.AspNetCore.Builder.WebApplication))
  (AppBuilder  (: Microsoft.AspNetCore.Builder.WebApplicationBuilder))
  (Pipeline    (: Microsoft.AspNetCore.Builder.IApplicationBuilder))
  (Ctx         (: Microsoft.AspNetCore.Http.HttpContext))
  (Incoming    (: Microsoft.AspNetCore.Http.HttpRequest))
  (Outgoing    (: Microsoft.AspNetCore.Http.HttpResponse))
  (PathText    (: Microsoft.AspNetCore.Http.PathString))
  (QueryText   (: Microsoft.AspNetCore.Http.QueryString))
  (HeaderDict  (: Microsoft.AspNetCore.Http.IHeaderDictionary))
  ;; Represents one or more string values for a header.
  (Values      (: Microsoft.Extensions.Primitives.StringValues (-> string Values)))
  ((Collection %a) (: System.Collections.Generic.ICollection))
  (Stream      (: System.IO.Stream))
  (Encoding    (: System.Text.Encoding))
  (SizeLimit   (: Microsoft.AspNetCore.Http.Features.IHttpMaxRequestBodySizeFeature))
  ;; What Kestrel raises for a request it will not take: 413 for a body over
  ;; the limit, 400 for one that is malformed or cut short.
  (Rejected    (: Microsoft.AspNetCore.Http.BadHttpRequestException))
  ;; The request body, unowned for the reason `BodyPort` is.
  (BodyIn      (: Bjolang.Runtime.BjoByteInputPort (-> Stream bool BodyIn)))
  (Object      (: System.Object))
  ((Pairing %k %v) (: System.Collections.Generic.KeyValuePair))
  (Lifetime    (: Microsoft.Extensions.Hosting.IHostApplicationLifetime))
  (Features    (: Microsoft.AspNetCore.Http.Features.IFeatureCollection))
  (UpgradeFeature (: Microsoft.AspNetCore.Http.Features.IHttpUpgradeFeature))
  (ConnInfo    (: Microsoft.AspNetCore.Http.ConnectionInfo))
  (Address     (: System.Net.IPAddress))
  (Endpoint    (: System.Net.IPEndPoint))
  ;; An address with a prefix length. Made with the whole length, it is the
  ;; one address.
  (Network     (: System.Net.IPNetwork (-> Address int Network)))
  (Refusal     (: System.ArgumentException (-> string Refusal)))
  ;; A byte port over a stream it does not own, for the response body: nothing
  ;; registers it on a scope, so no scope's release writes to it with a
  ;; blocking call, and closing it leaves the stream to Kestrel.
  (BodyPort    (: Bjolang.Runtime.BjoByteOutputPort (-> Stream bool BodyPort))))

(import/extern
  ;; --- Building and running the host ---
  ;;
  ;; Uses CreateSlimBuilder for a faster startup with fewer default services.
  (slim-builder  (: Microsoft.AspNetCore.Builder.WebApplication.CreateSlimBuilder (-> AppBuilder)))
  (build-app     (: Microsoft.AspNetCore.Builder.WebApplicationBuilder.Build (-> AppBuilder App)))
  (app-urls      (: Microsoft.AspNetCore.Builder.WebApplication.Urls (-> App (Collection string)) #:get))
  (app-start     (: Microsoft.AspNetCore.Builder.WebApplication.StartAsync (-> App void) #:async))
  (app-stop      (: Microsoft.AspNetCore.Builder.WebApplication.StopAsync (-> App void) #:async))
  ;; Runs the application and blocks until host shutdown.
  ;; `#:uncancellable` is used because RunAsync relies on host signal handling.
  (app-run       (: Microsoft.AspNetCore.Builder.WebApplication.RunAsync (-> App string void)
                    #:async #:uncancellable))

  ;; Registers middleware. Uses the `Func<HttpContext, Func<Task>, Task>` overload.
  (use!          (: Microsoft.AspNetCore.Builder.UseExtensions.Use
                    (-> Pipeline (-> Ctx (-> Task) Task) Pipeline)))
  (use-static-files! (: Microsoft.AspNetCore.Builder.StaticFileExtensions.UseStaticFiles
                        (-> Pipeline Pipeline)))

  ;; --- Reading a request ---
  (ctx-request   (: Microsoft.AspNetCore.Http.HttpContext.Request  (-> Ctx Incoming) #:get))
  (ctx-response  (: Microsoft.AspNetCore.Http.HttpContext.Response (-> Ctx Outgoing) #:get))
  ;; Token triggered when the client disconnects.
  (ctx-aborted   (: Microsoft.AspNetCore.Http.HttpContext.RequestAborted (-> Ctx CancellationToken) #:get))
  (in-method     (: Microsoft.AspNetCore.Http.HttpRequest.Method      (-> Incoming string) #:get))
  (in-path       (: Microsoft.AspNetCore.Http.HttpRequest.Path        (-> Incoming PathText) #:get))
  (in-query      (: Microsoft.AspNetCore.Http.HttpRequest.QueryString (-> Incoming QueryText) #:get))
  (in-headers    (: Microsoft.AspNetCore.Http.HttpRequest.Headers     (-> Incoming HeaderDict) #:get))
  (in-body       (: Microsoft.AspNetCore.Http.HttpRequest.Body        (-> Incoming Stream) #:get))
  (path-text     (: Microsoft.AspNetCore.Http.PathString.Value        (-> PathText string) #:get))
  (query-text    (: Microsoft.AspNetCore.Http.QueryString.Value       (-> QueryText string) #:get))

  ;; --- Writing a response ---
  (out-status!   (: Microsoft.AspNetCore.Http.HttpResponse.StatusCode  (-> Outgoing int void) #:set))
  (out-type!     (: Microsoft.AspNetCore.Http.HttpResponse.ContentType (-> Outgoing string void) #:set))
  (out-headers   (: Microsoft.AspNetCore.Http.HttpResponse.Headers     (-> Outgoing HeaderDict) #:get))
  (header-add!   (: Microsoft.AspNetCore.Http.HeaderDictionaryExtensions.Append
                    (-> HeaderDict string Values void)))
  (out-body      (: Microsoft.AspNetCore.Http.HttpResponse.Body (-> Outgoing Stream) #:get))
  (body-write!   (: System.IO.Stream.WriteAsync (-> Stream (Array byte) int int void) #:async))
  ;; Sends the head now, before any of a streamed body exists.
  (start!        (: Microsoft.AspNetCore.Http.HttpResponse.StartAsync (-> Outgoing void) #:async))
  ;; Drops the connection, so that a body that was cut off is not taken for a
  ;; whole one.
  (abort!        (: Microsoft.AspNetCore.Http.HttpContext.Abort (-> Ctx void)))

  ;; --- Stopping ---
  (app-lifetime  (: Microsoft.AspNetCore.Builder.WebApplication.Lifetime (-> App Lifetime) #:get))
  (stopping      (: Microsoft.Extensions.Hosting.IHostApplicationLifetime.ApplicationStopping
                    (-> Lifetime CancellationToken) #:get))

  ;; --- Upgrading a connection ---
  ;;
  ;; `UpgradeAsync` has no overload taking a token. It sends the `101` with
  ;; whatever response headers are set, and answers the raw connection.
  (ctx-features  (: Microsoft.AspNetCore.Http.HttpContext.Features (-> Ctx Features) #:get))
  (upgrade-feature (: Microsoft.AspNetCore.Http.Features.IFeatureCollection.Get
                      (-> Features UpgradeFeature)))
  (upgradable?   (: Microsoft.AspNetCore.Http.Features.IHttpUpgradeFeature.IsUpgradableRequest
                    (-> UpgradeFeature bool) #:get))
  (upgrade!      (: Microsoft.AspNetCore.Http.Features.IHttpUpgradeFeature.UpgradeAsync
                    (-> UpgradeFeature Stream) #:async #:uncancellable))
  (ctx-connection (: Microsoft.AspNetCore.Http.HttpContext.Connection (-> Ctx ConnInfo) #:get))
  (remote-ip     (: Microsoft.AspNetCore.Http.ConnectionInfo.RemoteIpAddress
                    (-> ConnInfo Address) #:get))
  (remote-port   (: Microsoft.AspNetCore.Http.ConnectionInfo.RemotePort (-> ConnInfo int) #:get))

  ;; --- Who asked ---
  (in-scheme     (: Microsoft.AspNetCore.Http.HttpRequest.Scheme (-> Incoming string) #:get))
  (try-address   (: System.Net.IPAddress.TryParse (-> string (out Address) (Option Address))))
  ;; An address as `X-Forwarded-For` has it, which some proxies write with a
  ;; port: `203.0.113.7:4711`, `[2001:db8::1]:4711`.
  (try-endpoint  (: System.Net.IPEndPoint.TryParse (-> string (out Endpoint) (Option Endpoint))))
  (endpoint-address (: System.Net.IPEndPoint.Address (-> Endpoint Address) #:get))
  ;; Clears the bits past the prefix: `10.0.0.1/8` is `10.0.0.0/8`.
  (try-network   (: System.Net.IPNetwork.TryParse (-> string (out Network) (Option Network))))
  (in-network?   (: System.Net.IPNetwork.Contains (-> Network Address bool)))
  ;; A server listening on IPv6 sees an IPv4 client as `::ffff:203.0.113.7`,
  ;; which is in no IPv4 network.
  (mapped?       (: System.Net.IPAddress.IsIPv4MappedToIPv6 (-> Address bool) #:get))
  (to-ipv4       (: System.Net.IPAddress.MapToIPv4 (-> Address Address)))
  (address-bytes (: System.Net.IPAddress.GetAddressBytes (-> Address (Array byte))))

  ;; --- The size of a body ---
  (size-limit    (: Microsoft.AspNetCore.Http.Features.IFeatureCollection.Get
                    (-> Features SizeLimit)))
  (limit-fixed?  (: Microsoft.AspNetCore.Http.Features.IHttpMaxRequestBodySizeFeature.IsReadOnly
                    (-> SizeLimit bool) #:get))
  (limit!        (: Microsoft.AspNetCore.Http.Features.IHttpMaxRequestBodySizeFeature.MaxRequestBodySize
                    (-> SizeLimit (System.Nullable long) void) #:set))
  (rejected-status (: Microsoft.AspNetCore.Http.BadHttpRequestException.StatusCode
                      (-> Rejected int) #:get))

  ;; --- Base .NET ---
  (utf8          (: System.Text.Encoding.UTF8 #:get))
  ;; Never includes a byte order mark, whatever the encoding writes on a stream.
  (encode        (: System.Text.Encoding.GetBytes (-> Encoding string (Array byte))))
  (from-base64   (: System.Convert.FromBase64String (-> string (Array byte))
                    #:exceptions (System.FormatException)))
  ;; A completed task.
  (nothing-to-do (: System.Threading.Tasks.Task.CompletedTask Task #:get)))

;; Extracts a string, returning an empty string if null.
(: text-or-empty (-> string string))
(defun (text-or-empty s)
  (match (cast Object s)
    ((:is System.String present) present)
    (_ "")))

;; ===========================================================================
;; The server
;; ===========================================================================

;; An opaque record representing a running server instance.
;;
;; `going-away` is a latch, closed and never posted to: once the server begins
;; to stop, every open websocket is closed with 1001.
(type
  (: Server #:opaque
     (Record (: app App)
             (: requests (Inbox (Call Ctx Unit)))
             (: going-away (Inbox Unit))
             (: url string)
             (: port int))))

;; What every worker serves with. `going-away` is the server's latch.
(type
  (: Serving (Record (: router Router)
                     (: going-away (Inbox Unit))
                     (: trusted (Vec Network))
                     (: max-body int))))

;; The queue between Kestrel and the workers.
;;
;; Creates an inbox that drops the newest request if full (resulting in a 503).
(: make-request-inbox (-> int (Inbox (Call Ctx Unit))))
(defun (make-request-inbox queue) (make-inbox queue DropNewest))

;; Creates the ASP.NET WebApplication.
;; Sets the environment variable to reduce ASP.NET logging noise unless `#:quiet #f`.
(: new-app (-> bool string App))
(defun (new-app quiet static-dir)
  (when quiet
    (set-environment-variable! "Logging__LogLevel__Default" "Warning"))
  (set-environment-variable! "ASPNETCORE_WEBROOT" static-dir)
  (build-app (slim-builder)))

;; Middleware function bridging Kestrel requests to the worker inbox.
;; Returns a 503 if the queue is full.
(: knock (-> (Inbox (Call Ctx Unit)) Ctx (-> Task) Task))
(defun (knock requests ctx next)
  (match (inbox-try-call/token requests ctx (ctx-aborted ctx))
    ((Some answering) (cast Task answering))
    (None (refuse! ctx))))

;; Rejects a request with a 503 Service Unavailable status.
(: refuse! (-> Ctx Task))
(defun (refuse! ctx)
  (def out (ctx-response ctx))
  (out-status! out 503)
  (header-add! (out-headers out) "Retry-After" (Values. "1"))
  nothing-to-do)

(: latch (-> (Inbox Unit)))
(defun (latch) (make-inbox 1 DropNewest))

;; What `#:trusted-proxies` is unless told otherwise: a proxy on the same
;; machine.
(: loopback (Vec string))
(def loopback ["127.0.0.0/8" "::1"])

;; Starts a fiber that closes `going-away` when the host begins to stop.
;;
;; Kestrel's shutdown waits for every request still in flight, and an open
;; websocket is one, so without this Ctrl-C under `serve` would wait out the
;; host's shutdown timeout before the sockets were dropped.
;;
;; A fiber cannot wait on a .NET `CancellationToken` directly, but an inbox call
;; made with one can be: once the call is taken, the token firing is what makes
;; `call-abandoned` fire.
(: watch-host! (-> App (Inbox Unit) void))
(defun (watch-host! app going-away)
  (def watch (make-inbox 1 DropNewest))
  (ignore (inbox-call/token watch unit (stopping (app-lifetime app))))
  (spawn (watch-stopping watch going-away)))

(: watch-stopping (-bjo-> (Inbox (Call Unit Unit)) (Inbox Unit) Unit))
(defbjo (watch-stopping watch going-away)
  (match (sync (choose (wrap (inbox-recv watch) (fun (c) (Some c)))
                       (wrap (inbox-closed going-away) (fun (e) None))))
    (None unit)
    ((Some c)
     (sync (choose (wrap (call-abandoned c) (fun (u) unit))
                   (wrap (inbox-closed going-away) (fun (e) unit))))
     (inbox-close! going-away)
     (ignore (call-reply! c unit))
     unit)))

(: install-inbox! (-> App (Inbox (Call Ctx Unit)) bool void))
(defun (install-inbox! app requests static-files?)
  (when static-files?
    (ignore (use-static-files! (cast Pipeline app))))
  (ignore (use! (cast Pipeline app)
                (fun (ctx next) (knock requests ctx next)))))

;; Starts the server asynchronously. Workers are spawned in the caller's scope.
;;
;; `#:trusted-proxies` are the addresses, and the networks as `10.0.0.0/8`,
;; whose `X-Forwarded-*` headers are believed. Loopback unless told otherwise,
;; for a proxy on the same machine. One that is neither is refused here, with
;; an `ArgumentException`.
;;
;; `#:max-body` is how many bytes of a request body may be read into memory,
;; 1 MiB unless told otherwise. A body over it is answered 413 once a handler
;; asks for it; `request-body-port` may take more.
(: start-server (-bjo-> Router
                        (#:port int) (#:host string) (#:workers int) (#:queue int)
                        (#:quiet bool) (#:static-files bool) (#:static-dir string)
                        (#:trusted-proxies (Vec string)) (#:max-body int)
                        Server))
(defbjo (start-server rt #:port 8080 #:host "127.0.0.1" #:workers 16 #:queue 128 #:quiet #t #:static-files #f #:static-dir "wwwroot"
                      #:trusted-proxies loopback #:max-body 1048576)
  (def trusted (trusted-networks trusted-proxies))
  (def requests (make-request-inbox queue))
  (def going-away (latch))
  (def app (new-app quiet static-dir))
  (def url (str "http://" host ":" (int->string port)))
  (ignore (.Add (app-urls app) url))
  (install-inbox! app requests static-files)
  (watch-host! app going-away)
  (def serving (Serving (router rt) (going-away going-away) (trusted trusted) (max-body max-body)))
  (loop (:for i (range 0 workers))
        (:do (spawn (worker serving requests))))
  (app-start app)
  (Server (app app) (requests requests) (going-away going-away) (url url) (port port)))

;; Stops accepting requests, finishes pending ones, and shuts down the workers.
;; Open websockets are closed with 1001 first, since Kestrel's stop waits for
;; them.
(: stop-server! (-bjo-> Server void))
(defbjo (stop-server! s)
  (inbox-close! (record-ref s going-away))
  (app-stop (record-ref s app))
  (inbox-close! (record-ref s requests)))

;; Starts the server and blocks until stopped by an external signal (e.g., Ctrl-C).
(: serve (-bjo-> Router
                 (#:port int) (#:host string) (#:workers int) (#:queue int)
                 (#:quiet bool) (#:static-files bool) (#:static-dir string)
                 (#:trusted-proxies (Vec string)) (#:max-body int)
                 void))
(defbjo (serve rt #:port 8080 #:host "127.0.0.1" #:workers 16 #:queue 128 #:quiet #t #:static-files #f #:static-dir "wwwroot"
               #:trusted-proxies loopback #:max-body 1048576)
  (def trusted (trusted-networks trusted-proxies))
  (def requests (make-request-inbox queue))
  (def going-away (latch))
  (def app (new-app quiet static-dir))
  (install-inbox! app requests static-files)
  (def serving (Serving (router rt) (going-away going-away) (trusted trusted) (max-body max-body)))
  (ignore
   (with-scope
     (watch-host! app going-away)
     (loop (:for i (range 0 workers))
           (:do (spawn (worker serving requests))))
     (try
         (app-run app (str "http://" host ":" (int->string port)))
       #:finally (let ()
                   (inbox-close! going-away)
                   (inbox-close! requests))))))

(: server-url (-> Server string))
(defun (server-url s) (record-ref s url))

(: server-port (-> Server int))
(defun (server-port s) (record-ref s port))

;; Returns the number of requests dropped (503s) due to a full queue.
(: server-dropped-count (-> Server int))
(defun (server-dropped-count s) (inbox-dropped-count (record-ref s requests)))

;; ===========================================================================
;; A worker
;; ===========================================================================

;; A worker fiber processing requests until the inbox is closed.
(: worker (-bjo-> Serving (Inbox (Call Ctx Unit)) Unit))
(defbjo (worker serving requests)
  (let go ()
    (match (sync (choose (wrap (inbox-recv requests) (fun (c) (Some c)))
                         (wrap (inbox-closed requests) (fun (e) None))))
      (None unit)
      ((Some c) (answer serving c) (go)))))

;; Processes a single request call, ensuring it is always answered: here, or by
;; the websocket session it was handed to.
(: answer (-bjo-> Serving (Call Ctx Unit) void))
(defbjo (answer serving c)
  (def handed-off (make-box #f))
  (try
      (ignore (try (answer-now serving c handed-off) #:catch (System.Exception)))
    #:finally (unless (box-ref handed-off) (ignore (call-reply! c unit)))))

;; Executes the handler and writes the response.
;; Handles exceptions and client disconnections appropriately.
(: answer-now (-bjo-> Serving (Call Ctx Unit) (Box bool) Unit))
(defbjo (answer-now serving c handed-off)
  (def going-away (record-ref serving going-away))
  (def ctx (call-request c))
  (def req (read-request ctx (record-ref serving trusted) (record-ref serving max-body)))
  (match (sync (choose (wrap (promise-join (bjo (handle (record-ref serving router) req))) (fun (r) (Some r)))
                       (wrap (call-abandoned c) (fun (u) None))))
    ((Some (Ok answer))
     (match (response-body answer)
       ((Upgraded up) (upgrade-or-refuse! ctx req c answer up going-away handed-off))
       ((Streamed writer) (stream-or-head! ctx req c answer writer going-away handed-off))
       (_ (write-response! ctx answer)))
     unit)
    ((Some (Err e)) (answer-failure! ctx req c e) unit)
    (None unit)))

;; A handler that raised. Kestrel refusing the body — too large, malformed, cut
;; short — is the client's doing, and gets the status Kestrel chose; so is a
;; multipart body that breaks its format, which is a 400. Anything else goes to
;; the log, not to the page, and is a 500. A client that has gone hears
;; nothing, and a failure it caused by going is not logged.
(: answer-failure! (-bjo-> Ctx Request (Call Ctx Unit) Exception void))
(defbjo (answer-failure! ctx req c e)
  (unless (abandoned? c)
    (match e
      ((:is Microsoft.AspNetCore.Http.BadHttpRequestException rejected)
       (def code (rejected-status rejected))
       (write-response! ctx (respond code (str (int->string code) " " (.-Message rejected) "\n"))))
      ((:is System.Net.ProtocolViolationException broken)
       (write-response! ctx (bad-request (.-Message broken))))
      (_
       (log (str "bjoweb: " (request-method req) " " (request-path req) " raised: " (.-Message e)))
       (write-response! ctx (server-error))))))

;; ===========================================================================
;; Answers that outlive the worker
;; ===========================================================================
;;
;; A websocket session and a streamed body run on a fiber of their own, so that
;; a long one holds no worker. That fiber answers the call when it is done,
;; which is what hands the connection back to Kestrel.

;; Starts `run` on a fiber of its own. `run` closes the latch it is given once
;; it is running, and only then is `handed-off` set: a scope that has begun
;; closing refuses a new fiber, and then the call is still this worker's to
;; answer.
(: hand-off! (-bjo-> (-bjo-> (Inbox Unit) void) (Box bool) void))
(defbjo (hand-off! run handed-off)
  (def started (latch))
  (def running (bjo (run started)))
  (when (sync (choose (wrap (inbox-closed started) (fun (e) #t))
                      (wrap (promise-join running) (fun (r) #f))))
    (box-set! handed-off #t)))

;; What ended a session or a stream first.
(type (: Ending (Union (Returned (Result Exception Unit))
                       Gone
                       Stopping)))

;; ===========================================================================
;; A websocket
;; ===========================================================================

;; Hands the call to a session fiber, or answers why it cannot be upgraded.
(: upgrade-or-refuse! (-bjo-> Ctx Request (Call Ctx Unit) Response Upgrade (Inbox Unit) (Box bool)
                              void))
(defbjo (upgrade-or-refuse! ctx req c answer up going-away handed-off)
  (match (handshake-refusal ctx req)
    ((Some refusal) (write-response! ctx refusal))
    (None (hand-off! (bjoroutine (started) (run-session ctx c req answer up going-away started))
                     handed-off))))

;; Why a request that reached a websocket route cannot be upgraded, as the
;; answer to send instead, or `None` when it can.
(: handshake-refusal (-> Ctx Request (Option Response)))
(defun (handshake-refusal ctx req)
  (cond
    ((not (and (= (request-method req) "GET")
               (string-contains? (string-downcase (request-header-or req "connection" "")) "upgrade")
               (= (string-downcase (request-header-or req "upgrade" "")) "websocket")
               (upgradable? (upgrade-feature (ctx-features ctx)))))
     (Some (upgrade-required)))
    ((not (= (request-header-or req "sec-websocket-version" "") "13"))
     (Some (with-header (upgrade-required) "Sec-WebSocket-Version" "13")))
    ((not (key-ok? (request-header-or req "sec-websocket-key" "")))
     (Some (bad-request "Sec-WebSocket-Key is not 16 bytes of base64")))
    (else None)))

(: upgrade-required (-> Response))
(defun (upgrade-required)
  (respond 426 "426 Upgrade Required\n" #:headers [(Tuple "Upgrade" "websocket")]))

(: key-ok? (-> string bool))
(defun (key-ok? key)
  (match (from-base64 key)
    ((Ok bytes) (= (array-length bytes) 16))
    ((Err e) #f)))

;; For `peer-address`: the client's address and port, or `""`.
(: peer-of (-> Ctx string))
(defun (peer-of ctx)
  (match (peer-ip ctx)
    ((Some ip) (str (.ToString ip) ":" (int->string (remote-port (ctx-connection ctx)))))
    (None "")))

;; Answers the call once the socket is over, which is what hands the connection
;; back to Kestrel.
(: run-session (-bjo-> Ctx (Call Ctx Unit) Request Response Upgrade (Inbox Unit) (Inbox Unit) void))
(defbjo (run-session ctx c req answer up going-away started)
  (inbox-close! started)
  (try
      (match (try (session-now ctx c req answer up going-away) #:catch (System.Exception))
        ((Ok u) unit)
        ((Err e) (log (str "bjoweb: websocket " (request-path req) " failed: " (.-Message e)))))
    #:finally (ignore (call-reply! c unit))))

;; Sends the `101`, runs the session on the socket, and closes it: with 1000
;; when the session returns, 1011 when it raises, and 1001 when the server is
;; stopping. A session still running once the socket has closed is cancelled.
(: session-now (-bjo-> Ctx (Call Ctx Unit) Request Response Upgrade (Inbox Unit) void))
(defbjo (session-now ctx c req answer up going-away)
  (def protocol (record-ref up protocol))
  (def session (record-ref up session))
  (def headers (out-headers (ctx-response ctx)))
  (loop (:for h (response-headers answer))
        (:do (match h
               ((Tuple name value) (header-add! headers name (Values. value))))))
  (header-add! headers "Upgrade" (Values. "websocket"))
  (header-add! headers "Sec-WebSocket-Accept"
               (Values. (websocket-accept-key (request-header-or req "sec-websocket-key" ""))))
  (unless (string-empty? protocol)
    (header-add! headers "Sec-WebSocket-Protocol" (Values. protocol)))
  (with-cancel (stop)
    (def ws (match (stream->ports (upgrade! (upgrade-feature (ctx-features ctx))) #:peer (peer-of ctx))
              ((Tuple in out)
               (ports->websocket in out #:protocol protocol
                                 #:max-message (record-ref up max-message)
                                 #:keep-alive (record-ref up keep-alive)))))
    (def running (bjo (session ws)))
    (match (sync (choose (wrap (promise-join running) (fun (r) (Returned r)))
                         (wrap (websocket-closed ws) (fun (s) Gone))
                         (wrap (call-abandoned c) (fun (u) Gone))
                         (wrap (inbox-closed going-away) (fun (e) Stopping))))
      ((Returned (Ok u)) (websocket-close! ws))
      ((Returned (Err e))
       (log (str "bjoweb: websocket " (request-path req) " raised: " (.-Message e)))
       (websocket-close! ws #:code 1011 #:reason "internal error"))
      (Stopping (websocket-close! ws #:code 1001 #:reason "the server is stopping"))
      (Gone unit))
    (stop (Requested "the websocket is closed"))))

;; ===========================================================================
;; A streamed body
;; ===========================================================================

;; Hands a streamed body to a fiber of its own. A `HEAD`, or a status that
;; cannot have a body, gets the head alone and the writer is not called.
(: stream-or-head! (-bjo-> Ctx Request (Call Ctx Unit) Response BodyWriter (Inbox Unit) (Box bool)
                           void))
(defbjo (stream-or-head! ctx req c answer writer going-away handed-off)
  (if (or (= (request-method req) "HEAD") (not (body-allowed? (response-status answer))))
      (write-head! ctx answer #f)
      (hand-off! (bjoroutine (started) (run-stream ctx c req answer writer going-away started))
                 handed-off)))

;; Answers the call once the body is over. When it fails, the failure is logged
;; and the connection aborted, unless the client had gone first: a stream
;; whose client has gone is not the server's failure, and there is no
;; connection left to abort.
(: run-stream (-bjo-> Ctx (Call Ctx Unit) Request Response BodyWriter (Inbox Unit) (Inbox Unit) void))
(defbjo (run-stream ctx c req answer writer going-away started)
  (inbox-close! started)
  (try
      (match (try (stream-now ctx c answer writer going-away) #:catch (System.Exception))
        ((Ok u) unit)
        ((Err e)
         (unless (abandoned? c)
           (log (str "bjoweb: " (request-method req) " " (request-path req)
                     " stream raised: " (.-Message e)))
           (abort-quietly! ctx))))
    #:finally (ignore (call-reply! c unit))))

;; Whether the client has gone. `call-abandoned` stays ready once it has fired,
;; and a `choose` takes the first ready branch, so this does not wait.
(: abandoned? (-bjo-> (Call Ctx Unit) bool))
(defbjo (abandoned? c)
  (sync (choose (wrap (call-abandoned c) (fun (u) #t))
                (always #f))))

;; Aborting is the last thing done to a response that has failed, and nothing
;; that goes wrong in it is worth more than the failure that led to it.
(: abort-quietly! (-> Ctx void))
(defun (abort-quietly! ctx)
  (ignore (try (abort! ctx) #:catch (System.Exception))))

;; Sends the head, then runs the writer until it returns, the client goes or
;; the server stops. The head goes first so that a client sees the status
;; before the first byte of the body exists. Only a writer that returns ends
;; the body cleanly: a stopping server aborts the connection, and a writer
;; still running then is cancelled.
(: stream-now (-bjo-> Ctx (Call Ctx Unit) Response BodyWriter (Inbox Unit) void))
(defbjo (stream-now ctx c answer writer going-away)
  (def response (ctx-response ctx))
  (write-head! ctx answer #f)
  (start! response)
  (def out (cast ByteOutputPort (BodyPort. (out-body response) #f)))
  (def ending
    (with-cancel (stop)
      (def running (bjo (writer out)))
      (def winner (sync (choose (wrap (promise-join running) (fun (r) (Returned r)))
                                (wrap (call-abandoned c) (fun (u) Gone))
                                (wrap (inbox-closed going-away) (fun (e) Stopping)))))
      (stop (Requested "the stream is over"))
      winner))
  (match ending
    ((Returned (Ok u)) (close-byte-output-port! out))
    ((Returned (Err e)) (raise e))
    (Gone unit)
    (Stopping (abort-quietly! ctx))))

;; ===========================================================================
;; HttpContext -> Request
;; ===========================================================================

;; Everything but the body, which the request reads when it is asked for.
(: read-request (-> Ctx (Vec Network) int Request))
(defun (read-request ctx trusted max-body)
  (def in (ctx-request ctx))
  (def headers (collect-headers (cast (Seq (Pairing string Values)) (in-headers in))))
  (match (reached-as trusted ctx headers)
    ((Tuple scheme host client)
     (make-request/streamed (in-method in)
                            ;; The path text is already percent-decoded.
                            (text-or-empty (path-text (in-path in)))
                            (parse-query (text-or-empty (query-text (in-query in))))
                            headers
                            (fun (limit) (open-body ctx limit))
                            max-body
                            #:scheme scheme #:host host #:client client))))

;; The body as a port, with Kestrel's limit on it set to `limit`: a read past
;; it raises a `BadHttpRequestException` saying 413, and so does the first
;; read when `Content-Length` says it will be. Kestrel's own limit, 30 MB,
;; would otherwise stand in for ours.
;;
;; Unowned, so that no scope's release closes Kestrel's stream. The limit can
;; no longer be set once the body is being read, nor on an upgraded request.
(: open-body (-> Ctx int ByteInputPort))
(defun (open-body ctx limit)
  (match (cast Object (size-limit (ctx-features ctx)))
    ((:is Microsoft.AspNetCore.Http.Features.IHttpMaxRequestBodySizeFeature feature)
     (unless (limit-fixed? feature)
       (limit! feature (cast (System.Nullable long) (cast System.Int64 limit)))))
    (_ unit))
  (cast ByteInputPort (BodyIn. (in-body (ctx-request ctx)) #f)))

;; Collects headers into a map with lower-cased keys.
(: collect-headers (-> (Seq (Pairing string Values)) (Map string string)))
(defun (collect-headers headers)
  (loop (:for h headers)
        (:acc all (mapping (Tuple (string-downcase (.-Key h)) (.ToString (.-Value h)))))))

;; ===========================================================================
;; Who asked, and how
;; ===========================================================================
;;
;; Behind a reverse proxy the connection is the proxy's: its address, and the
;; scheme it reached this server with. What the client used arrives in
;; `X-Forwarded-For`, `-Proto` and `-Host`, which anybody can send, so they are
;; believed only from a connection whose address is a trusted proxy's.

;; `#:trusted-proxies`, parsed before the server starts: a typo there would
;; otherwise trust nobody, or the wrong network, in silence.
(: trusted-networks (-> (Vec string) (Vec Network)))
(defun (trusted-networks names)
  (loop (:for name names)
        (:acc out (vecing (match (network-of (string-trim name))
                            ((Some n) n)
                            (None (raise (cast Exception
                                               (Refusal. (str "bjoweb: #:trusted-proxies: \"" name
                                                              "\" is neither an address nor a"
                                                              " network such as 10.0.0.0/8"))))))))))

;; An address stands for the network of that one address.
(: network-of (-> string (Option Network)))
(defun (network-of text)
  (if (string-contains? text "/")
      (try-network text)
      (match (try-address text)
        ((Some ip) (let ((plain (unmapped ip)))
                     (Some (Network. plain (* 8 (array-length (address-bytes plain)))))))
        (None None))))

(: unmapped (-> Address Address))
(defun (unmapped ip) (if (mapped? ip) (to-ipv4 ip) ip))

(: trusted? (-> (Vec Network) Address bool))
(defun (trusted? trusted ip)
  (let go ((i 0))
    (cond ((= i (vec-length trusted)) #f)
          ((in-network? (vec-ref trusted i) ip) #t)
          (else (go (+ i 1))))))

(: peer-ip (-> Ctx (Option Address)))
(defun (peer-ip ctx)
  (match (cast Object (remote-ip (ctx-connection ctx)))
    ((:is System.Net.IPAddress ip) (Some (unmapped ip)))
    (_ None)))

;; The scheme, the host and the client's address, in that order. A connection
;; that is not a trusted proxy's speaks for itself, and `X-Forwarded-*` is
;; ignored.
(: reached-as (-> (Vec Network) Ctx (Map string string) (Tuple string string string)))
(defun (reached-as trusted ctx headers)
  (def scheme (in-scheme (ctx-request ctx)))
  (def host (map-ref-or headers "host" ""))
  (match (peer-ip ctx)
    ((Some ip) (if (trusted? trusted ip)
                   (forwarded trusted headers scheme host (.ToString ip))
                   (Tuple scheme host (.ToString ip))))
    (None (Tuple scheme host ""))))

;; What a trusted proxy says. Every proxy on the way appends the address it was
;; reached from to `X-Forwarded-For`, so read from the right the list can be
;; believed for as long as its addresses are trusted proxies. The first that is
;; not, or is not an address at all, is the client; anything left of it the
;; client may have written itself.
;;
;; `-Proto` and `-Host` are read as many entries from the right, or as far as
;; they go, since most proxies set them rather than append to them. A header
;; that is missing leaves what the connection says: with no `X-Forwarded-For`,
;; the proxy is the client.
(: forwarded (-> (Vec Network) (Map string string) string string string (Tuple string string string)))
(defun (forwarded trusted headers scheme host peer)
  (match (client-in trusted (header-list headers "x-forwarded-for"))
    ((Tuple client hops)
     (Tuple (string-downcase (from-right (header-list headers "x-forwarded-proto") hops scheme))
            (from-right (header-list headers "x-forwarded-host") hops host)
            (if (string-empty? client) peer client)))))

;; The client in a forwarded-for chain, and how many entries from the right it
;; is. When every entry is a trusted proxy, the leftmost is as far as the chain
;; can be believed. `""` for an empty chain.
(: client-in (-> (Vec Network) (Vec string) (Tuple string int)))
(defun (client-in trusted chain)
  (def last (- (vec-length chain) 1))
  (let go ((i last))
    (if (< i 0)
        (Tuple "" 0)
        (let ((entry (vec-ref chain i)))
          (match (hop-address entry)
            ((Some ip) (if (and (> i 0) (trusted? trusted ip))
                           (go (- i 1))
                           (Tuple (.ToString ip) (- last i))))
            (None (Tuple entry (- last i))))))))

(: hop-address (-> string (Option Address)))
(defun (hop-address entry)
  (match (try-endpoint entry)
    ((Some at) (Some (unmapped (endpoint-address at))))
    (None None)))

;; The entries of a header that is a comma-separated list. Two lines of one
;; header arrive joined with a comma already.
(: header-list (-> (Map string string) string (Vec string)))
(defun (header-list headers name)
  (vec-filter (fun (s) (not (string-empty? s)))
              (vec-map string-trim (string-split (map-ref-or headers name "") ","))))

;; The entry `n` from the right, the leftmost when there are fewer, and
;; `fallback` when there are none.
(: from-right (-> (Vec string) int string string))
(defun (from-right entries n fallback)
  (def at (- (- (vec-length entries) 1) n))
  (cond ((= (vec-length entries) 0) fallback)
        ((< at 0) (vec-ref entries 0))
        (else (vec-ref entries at))))

;; ===========================================================================
;; Response -> HttpResponse
;; ===========================================================================

;; Writes the status, the headers and a body known in full. `Content-Length` is
;; the body's, so one among the headers is dropped when there is a body to send.
(: write-response! (-bjo-> Ctx Response void))
(defbjo (write-response! ctx answer)
  (def out (ctx-response ctx))
  (def payload (if (body-allowed? (response-status answer))
                   (fixed-body (response-body answer))
                   None))
  (write-head! ctx answer (some? payload))
  (match payload
    ((Some bytes)
     (def n (array-length bytes))
     (header-add! (out-headers out) "Content-Length" (Values. (int->string n)))
     (when (> n 0) (body-write! (out-body out) bytes 0 n)))
    (None unit)))

;; The status, the content type and the headers. `drop-length` leaves out a
;; `Content-Length` among them, for a body whose length is known here.
(: write-head! (-> Ctx Response bool void))
(defun (write-head! ctx answer drop-length)
  (def out (ctx-response ctx))
  (out-status! out (response-status answer))
  (out-type! out (response-content-type answer))
  (loop (:for h (response-headers answer))
        (:do (match h
               ((Tuple name value)
                (unless (and drop-length (= (string-downcase name) "content-length"))
                  (header-add! (out-headers out) name (Values. value))))))))

;; 1xx, 204 and 304 have no body, and Kestrel refuses to write one.
(: body-allowed? (-> int bool))
(defun (body-allowed? status)
  (not (or (< status 200) (= status 204) (= status 304))))

;; The bytes of a body that is known in full.
(: fixed-body (-> Body (Option (Array byte))))
(defun (fixed-body b)
  (match b
    (Empty (Some (make-array 0)))
    ((Text s) (Some (encode utf8 s)))
    ((Bytes data) (Some data))
    ((Streamed writer) None)
    ((Upgraded up) None)))
