;; bjoweb/test.bjo — hello world, and a page.
;;
;;     bjo run test.bjo
;;     curl http://127.0.0.1:8080/
;;     curl http://127.0.0.1:8080/echo/hello
;;     curl http://127.0.0.1:8080/page/banana
;;
;; Ctrl-C stops it.

(import (bjoweb core)
        (bjoweb router)
        (bjoweb server)
        (bjoweb html))

(: show (-bjo-> Request Response))
(defbjo (show req)
  (def what (request-param-or req "what" "nothing"))
  (page '(html (head (title "bjoweb")
                     (meta (@ (charset "utf-8"))))
               (body (@ (class "card"))
                     (h1 "bjoweb")
                     (p "you asked for " (b ,what))
                     (hr)
                     (ul ,@(list-map link (list "banana" "apple" "<script>")))))))

;; Currently elaboration only works one way, so in return position i need to wrap it
;; 
(: link (-> string Node))
(defun (link what)
  (NSub '(li (a (@ (href ,(str "/page/" what))) ,what))))



(defbjo (main args)
  (serve (router
           (route-get "/" (fun (req) (text "hello, world\n")))
           ;; `:what` matches one segment and binds it under that name. It
           ;; arrives percent-decoded — that is the server's job, not yours.
           (route-get "/echo/:what"
                      (fun (req) (text (str (request-param-or req "what" "") "\n"))))
           (route-get "/page/:what" show))
         #:port 8080)
  0)
